{
  "name": "@tuix/runtime",
  "version": "1.0.0-rc.3",
  "description": "Runtime systems and MVU for Cinderlink",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./module/registry": {
      "types": "./src/module/registry.ts",
      "import": "./src/module/registry.ts",
      "default": "./src/module/registry.ts"
    },
    "./interactive": {
      "types": "./src/interactive.ts",
      "import": "./src/interactive.ts",
      "default": "./src/interactive.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "@tuix/input": "workspace:*",
    "@tuix/reactive": "workspace:*",
    "@tuix/view": "workspace:*",
    "effect": "^3.17.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
