{
  "name": "@tuix/debug",
  "version": "1.0.0-rc.3",
  "description": "Debugging and development tools for Cinderlink",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "@tuix/logger": "workspace:*",
    "@tuix/reactive": "workspace:*",
    "@tuix/jsx": "workspace:*",
    "@tuix/view": "workspace:*",
    "@tuix/bin": "workspace:*",
    "@tuix/runtime": "workspace:*",
    "@tuix/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
