{
  "name": "@tuix/input",
  "version": "1.0.0-rc.3",
  "description": "Keyboard, mouse, and focus management for terminal input",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./keyboard": {
      "types": "./src/keyboard/index.ts",
      "import": "./src/keyboard/index.ts",
      "default": "./src/keyboard/index.ts"
    },
    "./mouse": {
      "types": "./src/mouse/index.ts",
      "import": "./src/mouse/index.ts",
      "default": "./src/mouse/index.ts"
    },
    "./focus": {
      "types": "./src/focus/index.ts",
      "import": "./src/focus/index.ts",
      "default": "./src/focus/index.ts"
    },
    "./keyboard/keys": {
      "types": "./src/keyboard/keys.ts",
      "import": "./src/keyboard/keys.ts",
      "default": "./src/keyboard/keys.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "effect": "^3.16.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
