{
  "name": "@tuix/jsx",
  "version": "1.0.0-rc.3",
  "description": "JSX runtime for Tuix",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "import": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/dev.ts",
      "import": "./src/dev.ts"
    },
    "./events": {
      "types": "./src/events.ts",
      "import": "./src/events.ts",
      "default": "./src/events.ts"
    },
    "./app": {
      "types": "./src/app/index.ts",
      "import": "./src/app/index.ts",
      "default": "./src/app/index.ts"
    },
    "./scope": {
      "types": "./src/scope/index.ts",
      "import": "./src/scope/index.ts",
      "default": "./src/scope/index.ts"
    },
    "./scope/manager": {
      "types": "./src/scope/manager.ts",
      "import": "./src/scope/manager.ts",
      "default": "./src/scope/manager.ts"
    },
    "./scope/types": {
      "types": "./src/scope/types.ts",
      "import": "./src/scope/types.ts",
      "default": "./src/scope/types.ts"
    },
    "./scope/components": {
      "types": "./src/scope/components/index.ts",
      "import": "./src/scope/components/index.ts",
      "default": "./src/scope/components/index.ts"
    },
    "./scope/stores": {
      "types": "./src/scope/stores/index.ts",
      "import": "./src/scope/stores/index.ts",
      "default": "./src/scope/stores/index.ts"
    },
    "./config": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "@tuix/ansi": "workspace:*",
    "@tuix/config": "workspace:*",
    "@tuix/runtime": "workspace:*",
    "@tuix/reactive": "workspace:*",
    "@tuix/debug": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0",
    "@tuix/view": "workspace:*"
  }
}
