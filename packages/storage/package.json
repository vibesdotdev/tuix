{
  "name": "@tuix/storage",
  "version": "0.1.0",
  "description": "Key-value storage with TTL support for TUIX framework",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "import": "./src/plugin/index.ts",
      "default": "./src/plugin/index.ts"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "effect": "^3.16.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "tuix",
    "storage",
    "key-value",
    "ttl",
    "cache"
  ],
  "author": "TUIX Team",
  "license": "MIT"
}
