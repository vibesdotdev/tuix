{
  "name": "@tuix/core",
  "version": "1.0.0-rc.3",
  "description": "Foundational TUI functionality for Cinderlink",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "import": "./src/events/index.ts",
      "default": "./src/events/index.ts"
    },
    "./events/event-bus": {
      "types": "./src/events/event-bus.ts",
      "import": "./src/events/event-bus.ts",
      "default": "./src/events/event-bus.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./services/live": {
      "types": "./src/services/live/index.ts",
      "import": "./src/services/live/index.ts",
      "default": "./src/services/live/index.ts"
    },
    "./services/live/terminal": {
      "types": "./src/services/live/terminal.ts",
      "import": "./src/services/live/terminal.ts",
      "default": "./src/services/live/terminal.ts"
    },
    "./services/live/renderer": {
      "types": "./src/services/live/renderer.ts",
      "import": "./src/services/live/renderer.ts",
      "default": "./src/services/live/renderer.ts"
    },
    "./services/live/storage": {
      "types": "./src/services/live/storage.ts",
      "import": "./src/services/live/storage.ts",
      "default": "./src/services/live/storage.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@effect/schema": "^0.75.5",
    "@tuix/ansi": "workspace:*",
    "@tuix/input": "workspace:*",
    "effect": "^3.16.9",
    "uuid": "^14.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tuix/reactive": "workspace:*",
    "@tuix/runtime": "workspace:*",
    "@tuix/view": "workspace:*",
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0",
    "typescript": "^5.3.0"
  }
}
