{
  "name": "@tuix/view",
  "version": "1.0.0-rc.3",
  "description": "View primitives, layouts, and caching for TUI rendering",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./primitives/*": {
      "types": "./src/primitives/*",
      "import": "./src/primitives/*",
      "default": "./src/primitives/*"
    },
    "./layout/*": {
      "types": "./src/layout/*",
      "import": "./src/layout/*",
      "default": "./src/layout/*"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "@tuix/ansi": "workspace:*",
    "effect": "^3.16.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "bun": "^1.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
