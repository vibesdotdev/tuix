{
  "name": "@tuix/app-presets",
  "version": "1.0.0-rc.3",
  "description": "Higher-layer module presets for Tuix bootstrap",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/config": "workspace:*",
    "@tuix/coordination": "workspace:*",
    "@tuix/core": "workspace:*",
    "@tuix/logger": "workspace:*",
    "@tuix/process-manager": "workspace:*",
    "@tuix/reactive": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
