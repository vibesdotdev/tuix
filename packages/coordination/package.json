{
  "name": "@tuix/coordination",
  "version": "1.0.0-rc.3",
  "description": "Advanced coordination patterns for orchestration, choreography, and streaming",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./orchestration": {
      "types": "./src/orchestration/index.ts",
      "import": "./src/orchestration/index.ts",
      "default": "./src/orchestration/index.ts"
    },
    "./choreography": {
      "types": "./src/choreography/index.ts",
      "import": "./src/choreography/index.ts",
      "default": "./src/choreography/index.ts"
    },
    "./streams": {
      "types": "./src/streams/index.ts",
      "import": "./src/streams/index.ts",
      "default": "./src/streams/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "@tuix/reactive": "workspace:*",
    "effect": "^3.16.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "bun": "^1.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
