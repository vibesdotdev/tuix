{
  "name": "@tuix/bin",
  "version": "1.0.0-rc.3",
  "description": "TUIX CLI - Modern Terminal UI Framework",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "tuix": "./src/bin/tuix.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "start": "bun run src/bin/tuix.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "@tuix/jsx": "workspace:*",
    "@tuix/reactive": "workspace:*",
    "@tuix/ui": "workspace:*",
    "@tuix/themes": "workspace:*",
    "@tuix/docs": "workspace:*",
    "@tuix/config": "workspace:*",
    "@tuix/logger": "workspace:*",
    "@tuix/process-manager": "workspace:*",
    "@tuix/testing": "workspace:*",
    "@tuix/debug": "workspace:*",
    "@tuix/update": "workspace:*",
    "@tuix/telemetry": "workspace:*",
    "effect": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
