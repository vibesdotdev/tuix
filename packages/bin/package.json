{
  "name": "@tuix/bin",
  "version": "1.0.0-rc.3",
  "description": "TUIX CLI binary - entry point for the TUI framework",
  "type": "module",
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "bin": {
    "tuix": "./bin/index.ts"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/config": "workspace:*",
    "@tuix/core": "workspace:*",
    "@tuix/debug": "workspace:*",
    "@tuix/jsx": "workspace:*",
    "@tuix/logger": "workspace:*",
    "@tuix/process-manager": "workspace:*",
    "@tuix/testing": "workspace:*",
    "@tuix/ui": "workspace:*",
    "@effect/cli": "^0.68.0",
    "@effect/platform-node": "^0.92.0",
    "@effect/schema": "^0.75.5",
    "@types/figlet": "^1.7.0",
    "biome": "^0.3.3",
    "commander": "^11.1.0",
    "effect": "^3.16.9",
    "figlet": "^1.8.1",
    "strip-ansi": "^7.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "bun": "^1.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
