{
  "name": "@tuix/ansi",
  "version": "1.0.0-rc.3",
  "description": "ANSI utilities for TUIX terminal applications",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./core/*": {
      "types": "./src/core/*",
      "import": "./src/core/*",
      "default": "./src/core/*"
    },
    "./color": {
      "types": "./src/color/index.ts",
      "import": "./src/color/index.ts",
      "default": "./src/color/index.ts"
    },
    "./color/*": {
      "types": "./src/color/*",
      "import": "./src/color/*",
      "default": "./src/color/*"
    },
    "./style": {
      "types": "./src/style/index.ts",
      "import": "./src/style/index.ts",
      "default": "./src/style/index.ts"
    },
    "./style/*": {
      "types": "./src/style/*",
      "import": "./src/style/*",
      "default": "./src/style/*"
    },
    "./border": {
      "types": "./src/border/index.ts",
      "import": "./src/border/index.ts",
      "default": "./src/border/index.ts"
    },
    "./border/*": {
      "types": "./src/border/*",
      "import": "./src/border/*",
      "default": "./src/border/*"
    },
    "./gradient": {
      "types": "./src/gradient/index.ts",
      "import": "./src/gradient/index.ts",
      "default": "./src/gradient/index.ts"
    },
    "./gradient/*": {
      "types": "./src/gradient/*",
      "import": "./src/gradient/*",
      "default": "./src/gradient/*"
    },
    "./render": {
      "types": "./src/render/index.ts",
      "import": "./src/render/index.ts",
      "default": "./src/render/index.ts"
    },
    "./render/*": {
      "types": "./src/render/*",
      "import": "./src/render/*",
      "default": "./src/render/*"
    },
    "./parser": {
      "types": "./src/parser/index.ts",
      "import": "./src/parser/index.ts",
      "default": "./src/parser/index.ts"
    },
    "./parser/*": {
      "types": "./src/parser/*",
      "import": "./src/parser/*",
      "default": "./src/parser/*"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "bun": "^1.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
