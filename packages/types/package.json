{
  "name": "@tuix/types",
  "version": "0.1.0",
  "description": "Shared type definitions for TUIX framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
