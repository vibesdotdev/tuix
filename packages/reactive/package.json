{
  "name": "@tuix/reactive",
  "version": "1.0.0-rc.3",
  "description": "Reactivity system with runes, scopes, and JSX lifecycle management",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runes": {
      "types": "./src/runes/index.ts",
      "import": "./src/runes/index.ts",
      "default": "./src/runes/index.ts"
    },
    "./scope": {
      "types": "./src/scope/index.ts",
      "import": "./src/scope/index.ts",
      "default": "./src/scope/index.ts"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "import": "./src/events/index.ts",
      "default": "./src/events/index.ts"
    },
    "./events/event-bus": {
      "types": "./src/events/event-bus.ts",
      "import": "./src/events/event-bus.ts",
      "default": "./src/events/event-bus.ts"
    },
    "./jsx-lifecycle": {
      "types": "./src/runes/jsx-lifecycle.ts",
      "import": "./src/runes/jsx-lifecycle.ts",
      "default": "./src/runes/jsx-lifecycle.ts"
    },
    "./scope/manager": {
      "types": "./src/scope/manager.ts",
      "import": "./src/scope/manager.ts",
      "default": "./src/scope/manager.ts"
    },
    "./scope/jsx/stores": {
      "types": "./src/scope/jsx/stores/index.ts",
      "import": "./src/scope/jsx/stores/index.ts",
      "default": "./src/scope/jsx/stores/index.ts"
    },
    "./runes/runes": {
      "types": "./src/runes/runes.ts",
      "import": "./src/runes/runes.ts",
      "default": "./src/runes/runes.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "bun build --target=bun --minify --splitting src/index.ts --outdir=dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tuix/core": "workspace:*",
    "effect": "^3.16.9",
    "@tuix/runtime": "workspace:*",
    "@tuix/jsx": "workspace:*",
    "@tuix/debug": "workspace:*",
    "@tuix/ansi": "workspace:*",
    "@tuix/view": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
