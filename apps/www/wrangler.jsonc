// Generated by @vibesdotdev/infra-cloudflare (Workers + assets shape, per deployment.config.ts)
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tuix-www",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": true
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"routes": [
		{
			"pattern": "tuix.vibes.dev",
			"custom_domain": true
		}
	],
	"vars": {
		"PUBLIC_TUIX_ORIGIN": "https://tuix.vibes.dev",
		"PUBLIC_VIBES_BASE_DOMAIN": "vibes.dev",
		"PUBLIC_VIBES_ASSETS_ORIGIN": "https://assets.vibes.dev",
		"NODE_ENV": "production"
	},
	"analytics_engine_datasets": [
		{
			"binding": "BANDWIDTH_TELEMETRY",
			"dataset": "bandwidth_egress"
		}
	]
}
