  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@ast-grep/cli": "^0.39.6",
    "@biomejs/biome": "^1.7.3",
    "@types/bun": "^1.2.23",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  }
}
