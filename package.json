{
  "name": "tuix",
  "private": true,
  "scripts": {
    "tuix": "bun run packages/bin/src/bin/tuix.ts",
    "build": "bun run ./scripts/build.ts",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format .",
    "test": "bun test",
